# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB connection string (database name is taken from the path)
MONGODB_URI=mongodb://127.0.0.1:27017/keel

# Base64 of 32 random bytes, used for AES-256-GCM encryption of secret values.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the database and out of version control.
SECRETS_ENCRYPTION_KEY=

# Formas form key for the contact page. Public by design: it ships to the browser.
NEXT_PUBLIC_FORMAS_API_KEY=

# Public origin of the site, used for absolute social preview URLs.
# Example: https://keel.example.com
NEXT_PUBLIC_SITE_URL=

# Optional: Google Search Console "HTML tag" verification token (the content
# value only). Leave empty if you verify the domain through DNS instead.
GOOGLE_SITE_VERIFICATION=
